# Получить токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# API-ключ OpenAI. Не публикуйте настоящий ключ в GitHub.
OPENAI_API_KEY=

# Модель можно заменить без изменения кода
OPENAI_MODEL=gpt-4.1-mini

# Путь к локальной базе SQLite
DATABASE_PATH=data/bot.sqlite3

# Имя бота в системной инструкции
BOT_NAME=Персональный помощник
